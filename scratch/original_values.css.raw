1: /* ==========================================================================
2:    AVENRIX HEALTHCARE SOLUTIONS — WHAT WE STAND FOR SECTION
3:    Architectural Editorial Styles (.avx-values, .avx-value)
4:    Inspired by The July Reference: Pure Editorial Typography, Monumental Numerals,
5:    Continuous Architectural Timeline Spine, and Refined Whitespace.
6:    (No generic boxed cards; cohesive editorial storytelling)
7:    ========================================================================== */
8: 
9: .avx-values {
10:   position: relative;
11:   background-color: var(--avx-white);
12:   padding-top: clamp(4rem, 7vw, 7.5rem);
13:   padding-bottom: clamp(4rem, 7vw, 7.5rem);
14:   scroll-margin-top: clamp(4.5rem, 8vw, 6rem);
15:   border-top: none;
16:   overflow: hidden;
17: }
18: 
19: /* Subtle Architectural Grid Background Watermark */
20: .avx-values__bg-grid {
21:   position: absolute;
22:   inset: 0;
23:   pointer-events: none;
24:   background-image: 
25:     linear-gradient(to right, var(--avx-grid-line-light) 1px, transparent 1px),
26:     linear-gradient(to bottom, var(--avx-grid-line-light) 1px, transparent 1px);
27:   background-size: var(--avx-grid-size) var(--avx-grid-size);
28:   background-position: 0 0;
29:   mask-image: radial-gradient(circle at 15% 45%, black 20%, transparent 75%);
30:   -webkit-mask-image: radial-gradient(circle at 15% 45%, black 20%, transparent 75%);
31:   z-index: 1;
32: }
33: 
34: .avx-values__container {
35:   position: relative;
36:   z-index: 2;
37: }
38: 
39: /* --------------------------------------------------------------------------
40:    Editorial Layout: Asymmetric 2-Column Desktop Architecture
41:    -------------------------------------------------------------------------- */
42: .avx-values__layout {
43:   display: grid;
44:   grid-template-columns: minmax(320px, 390px) 1fr;
45:   gap: clamp(3.5rem, 7vw, 7rem);
46:   align-items: start;
47: }
48: 
